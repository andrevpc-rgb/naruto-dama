# Copie este arquivo para ".env" (mesma pasta do server.js) e preencha os valores reais.
# O ".env" NUNCA deve ser commitado no Git — ele já está no .gitignore.

# String de conexão do MongoDB Atlas (Cluster > Connect > Drivers > Node.js).
# Exemplo: mongodb+srv://usuario:senha@cluster0.xxxxx.mongodb.net/damas-ninja?retryWrites=true&w=majority
MONGODB_URI=

# Chave secreta usada para assinar os tokens JWT. Use uma string longa e aleatória —
# por exemplo, gere uma com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Porta do servidor (opcional — o Render define isso automaticamente via variável de ambiente própria).
PORT=3001
